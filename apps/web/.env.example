# Servidor local de desarrollo
VITE_WS_URL=ws://localhost:8080
VITE_API_URL=http://localhost:8080
# Credencial de SOLO LECTURA. Viaja dentro del JavaScript publicado: nunca
# pongas aqui la credencial de escritura del celular.
VITE_VIEWER_TOKEN=dev-viewer
VITE_RETENTION_MIN=10

# Produccion (valores que imprime el despliegue)
