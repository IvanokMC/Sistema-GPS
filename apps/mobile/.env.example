# Servidor local: pon la IP LAN de tu PC (la imprime el servidor al arrancar),
# NO localhost, porque el celular no resuelve el localhost de la PC.
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:8080
EXPO_PUBLIC_AUTH_TOKEN=dev-token
EXPO_PUBLIC_DEVICE_ID=oppo-a78

# Produccion (valor que imprime "npm run deploy")
# EXPO_PUBLIC_WS_URL=wss://abc123.execute-api.us-east-1.amazonaws.com/prod
# EXPO_PUBLIC_AUTH_TOKEN=tu-token-secreto
